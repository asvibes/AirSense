# Illustrative demo settings only; confirm and cite each metric guideline.
AIRSENSE_HIGH_THRESHOLD=1500
AIRSENSE_ELEVATED_THRESHOLD=1000
AIRSENSE_ELEVATED_DURATION_SECONDS=300
AIRSENSE_RAPID_RISE_PER_MINUTE=200
AIRSENSE_ALL_CLEAR_DURATION_SECONDS=300
AIRSENSE_MAX_READING_GAP_SECONDS=120
AIRSENSE_MAX_FUTURE_SECONDS=60

# Enable both only when the deployment secret is configured.
AIRSENSE_API_TOKEN=
REQUIRE_API_TOKEN=false