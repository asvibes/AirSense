DATABASE_URL=sqlite:///instance/airsense.sqlite3
SECRET_KEY=replace-with-a-random-local-development-secret
BREVO_API_KEY=replace-with-your-brevo-transactional-api-key
MAIL_DEFAULT_SENDER=notifications@your-verified-domain.example
MAIL_DEFAULT_SENDER_NAME=AirSense
PUBLIC_BASE_URL=
EMAIL_VERIFICATION_REQUIRED=true
TRUSTED_PROXY_HOPS=0
PRIVATE_UPLOAD_FOLDER=instance/private_uploads

# Brevo setup: verify the sender/domain, then publish the SPF and DKIM records
# Brevo provides. Add a DMARC policy for the same domain after monitoring reports.

# Illustrative demo settings only; confirm and cite each metric guideline.
AIRSENSE_HIGH_THRESHOLD=1500
AIRSENSE_ELEVATED_THRESHOLD=1000
AIRSENSE_ELEVATED_DURATION_SECONDS=300
AIRSENSE_RAPID_RISE_PER_MINUTE=200
AIRSENSE_ALL_CLEAR_DURATION_SECONDS=300
AIRSENSE_MAX_READING_GAP_SECONDS=120
AIRSENSE_MAX_FUTURE_SECONDS=60

# Enable both only when the deployment secret is configured.
AIRSENSE_API_TOKEN=
REQUIRE_API_TOKEN=false